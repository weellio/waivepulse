# Working notes stay local, but the doc map does not: the README links to it and
# tests/test_doc_map.py checks it, so a clone without it has a broken link and a
# failing test. Excluding the CONTENTS rather than the directory is what makes the
# negation below possible at all - git will not look inside an excluded directory.
docs/*
!docs/DOC_MAP.md
outputs/
/lyrics/
history.json*
.claude/
.credentials/
.waivepulse.bat
.waivepulse.sh
__pycache__/
*.pyc
*.pyo
*.pyd
.env
*.egg-info/
dist/
build/
backup_v1_*/

# Godzilla music-video scratch / test assets — working material, not part of the app
artwork/
**/godzilla_mv/
brag-output*/
brag-assets/

# generated at runtime from the configured checkpoint folder
backend/comfy/extra_model_paths.yaml
data/cover_ai.json
.deploy-state.json
